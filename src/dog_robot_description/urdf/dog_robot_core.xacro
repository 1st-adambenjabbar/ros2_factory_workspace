<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dog_robot">
  <material name="dog_grey">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>
  <material name="dog_orange">
    <color rgba="0.9 0.4 0.05 1.0"/>
  </material>
  <material name="rubber">
    <color rgba="0.03 0.03 0.03 1.0"/>
  </material>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${mass * (y*y + z*z) / 12}" ixy="0" ixz="0"
               iyy="${mass * (x*x + z*z) / 12}" iyz="0"
               izz="${mass * (x*x + y*y) / 12}"/>
    </inertial>
  </xacro:macro>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.72 0.38 0.24"/></geometry>
      <material name="dog_grey"/>
    </visual>
    <collision>
      <geometry><box size="0.72 0.38 0.24"/></geometry>
    </collision>
    <xacro:box_inertial mass="18.0" x="0.72" y="0.38" z="0.24"/>
  </link>

  <link name="body_shell">
    <visual>
      <origin xyz="0 0 0.13" rpy="0 0 0"/>
      <geometry><box size="0.56 0.32 0.12"/></geometry>
      <material name="dog_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.13" rpy="0 0 0"/>
      <geometry><box size="0.56 0.32 0.12"/></geometry>
    </collision>
    <xacro:box_inertial mass="2.0" x="0.56" y="0.32" z="0.12"/>
  </link>

  <joint name="body_shell_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="body_shell"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="head_link">
    <visual>
      <geometry><box size="0.22 0.26 0.22"/></geometry>
      <material name="dog_grey"/>
    </visual>
    <collision><geometry><box size="0.22 0.26 0.22"/></geometry></collision>
    <xacro:box_inertial mass="2.0" x="0.22" y="0.26" z="0.22"/>
  </link>

  <joint name="neck_joint" type="revolute">
    <parent link="base_link"/>
    <child link="head_link"/>
    <origin xyz="0.40 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7" upper="0.7" effort="20" velocity="2"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.06" length="0.05"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision><geometry><cylinder radius="0.06" length="0.05"/></geometry></collision>
    <xacro:box_inertial mass="0.2" x="0.1" y="0.1" z="0.05"/>
  </link>

  <joint name="lidar_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.28" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.06 0.08 0.05"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision><geometry><box size="0.06 0.08 0.05"/></geometry></collision>
    <xacro:box_inertial mass="0.1" x="0.06" y="0.08" z="0.05"/>
  </link>

  <joint name="camera_fixed" type="fixed">
    <parent link="head_link"/>
    <child link="camera_link"/>
    <origin xyz="0.14 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="leg" params="prefix x y">
    <link name="${prefix}_hip">
      <visual>
        <geometry><cylinder radius="0.055" length="0.12"/></geometry>
        <material name="dog_orange"/>
      </visual>
      <collision><geometry><cylinder radius="0.055" length="0.12"/></geometry></collision>
      <xacro:box_inertial mass="0.6" x="0.12" y="0.12" z="0.12"/>
    </link>
    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_hip"/>
      <origin xyz="${x} ${y} 0" rpy="1.5708 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.1" upper="1.1" effort="60" velocity="5"/>
    </joint>
  </xacro:macro>

  <xacro:leg prefix="front_left" x="0.25" y="0.20"/>
  <xacro:leg prefix="front_right" x="0.25" y="-0.20"/>
  <xacro:leg prefix="rear_left" x="-0.25" y="0.20"/>
  <xacro:leg prefix="rear_right" x="-0.25" y="-0.20"/>
</robot>
