<?xml version="1.0"?>
<robot name="dog_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
<!--Materilas-->
<material name="dog_grey">
  <color rgba="0.35 0.35 0.35 1.0"/>
</material>
<material name="dog_orange">
  <color rgba="0.9 0.4 0.05 1.0"/>
</material>
<xacro:property name="hip_length" value="0.06"/>
<xacro:property name="hip_radius" value="0.035"/>
<xacro:property name="thigh_length" value="0.18"/>
<xacro:property name="thigh_width" value="0.04"/>
<xacro:property name="shin_length" value="0.18"/>
<xacro:property name="shin_width" value="0.03"/>
<xacro:property name="foot_radius" value="0.025"/>
<!-- base link-->
  <link name="base_link">
   <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.25 0.12"/>
      </geometry>
      <material name="dog_grey"/>  
   </visual>
<collision>
 <origin xyz="0 0 0" rpy="0 0 0"/>
 <geometry>
   <box size="0.5 0.25 0.12"/>
 </geometry>
</collision>
<inertial>
 <mass value="8.0"/>
 <origin xyz="0 0 0" rpy="0 0 0"/>
 <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.09"/>
 </inertial>
</link>
<!-- ==================== HEAD LINK ==================== -->
<link name="head_link">
<visual>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<box size="0.12 0.12 0.10"/>
</geometry>
<material name="dog_grey"/>
</visual>
<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<box size="0.12 0.12 0.10"/>
</geometry>
</collision>
<inertial>
<mass value="0.4"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
</inertial>
</link>
<joint name="head_joint" type="revolute">
<parent link="base_link"/>
<child link="head_link"/>
<origin xyz="0.27 0 0.09" rpy="0 0 0"/>
<axis xyz="0 0 1"/>
<limit lower="-0.9" upper="0.9" effort="5.0" velocity="1.0"/>
</joint>
<!--  BODY SHELL  -->
<link name="body_shell">
<visual>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<box size="0.46 0.22 0.06"/>
</geometry>
<material name="dog_orange"/>
</visual>
</link>
<joint name="body_shell_fixed" type="fixed">
<parent link="base_link"/>
<child link="body_shell"/>
<origin xyz="0 0 0.09" rpy="0 0 0"/>
</joint>
<!-- ==================== LEG MACRO ==================== -->
<xacro:macro name="leg" params="prefix x_reflect y_reflect hip_x hip_y">
<!-- ==================== HIP ==================== -->
<link name="${prefix}_hip">
<visual>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="${hip_radius}" length="${hip_length}"/>
</geometry>
<material name="dog_grey"/>
</visual>
<collision>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="${hip_radius}" length="${hip_length}"/>
</geometry>
</collision>
<inertial>
<mass value="0.3"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia ixx="0.0003" ixy="0.0" ixz="0.0" iyy="0.0003" iyz="0.0" izz="0.0003"/>
</inertial>
</link>
<joint name="${prefix}_hip_joint" type="revolute">
<parent link="base_link"/>
<child link="${prefix}_hip"/>
<origin xyz="${hip_x} ${hip_y} 0" rpy="0 0 0"/>
<axis xyz="1 0 0"/>
<limit lower="-0.7" upper="0.7" effort="20.0" velocity="10.0"/>
</joint>
<!-- ==================== THIGH ==================== -->
<link name="${prefix}_thigh">
<visual>
<origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>
<geometry>
<box size="${thigh_width} ${thigh_width} ${thigh_length}"/>
</geometry>
<material name="dog_grey"/>
</visual>
<collision>
<origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>
<geometry>
<box size="${thigh_width} ${thigh_width} ${thigh_length}"/>
</geometry>
</collision>
<inertial>
<mass value="0.6"/>
<origin xyz="0 0 ${-thigh_length/2}" rpy="0 0 0"/>
<inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.0005"/>
</inertial>
</link>
<joint name="${prefix}_thigh_joint" type="revolute">
<parent link="${prefix}_hip"/>
<child link="${prefix}_thigh"/>
<origin xyz="0 ${0.05 * y_reflect} 0" rpy="0 0 0"/>
<axis xyz="0 1 0"/>
<limit lower="-1.57" upper="1.57" effort="20.0" velocity="10.0"/>
</joint>
<!-- ==================== SHIN ==================== -->
<link name="${prefix}_shin">
<visual>
<origin xyz="0 0 ${-shin_length/2}" rpy="0 0 0"/>
<geometry>
<box size="${shin_width} ${shin_width} ${shin_length}"/>
</geometry>
<material name="dog_grey"/>
</visual>
<collision>
<origin xyz="0 0 ${-shin_length/2}" rpy="0 0 0"/>
<geometry>
<box size="${shin_width} ${shin_width} ${shin_length}"/>
</geometry>
</collision>
<inertial>
<mass value="0.25"/>
<origin xyz="0 0 ${-shin_length/2}" rpy="0 0 0"/>
<inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0002"/>
</inertial>
</link>
<joint name="${prefix}_shin_joint" type="revolute">
<parent link="${prefix}_thigh"/>
<child link="${prefix}_shin"/>
<origin xyz="0 0 ${-thigh_length}" rpy="0 0 0"/>
<axis xyz="0 1 0"/>
<limit lower="-2.7" upper="-0.4" effort="20.0" velocity="10.0"/>
</joint>
<!-- FOOT -->
<link name="${prefix}_foot">
<visual>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<sphere radius="${foot_radius}"/>
</geometry>
<material name="dog_orange"/>
</visual>
<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<sphere radius="${foot_radius}"/>
</geometry>
</collision>
<inertial>
<mass value="0.05"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
<inertia ixx="0.00002" ixy="0.0" ixz="0.0" iyy="0.00002" iyz="0.0" izz="0.00002"/>
</inertial>
</link>
<joint name="${prefix}_foot_fixed" type="fixed">
<parent link="${prefix}_shin"/>
<child link="${prefix}_foot"/>
<origin xyz="0 0 ${-shin_length}" rpy="0 0 0"/>
</joint>
</xacro:macro>
<!--  CALL LEG MACRO — ALL FOUR LEGS -->
<xacro:leg prefix="FL" x_reflect="1" y_reflect="1" hip_x="0.18" hip_y="0.14"/>
<xacro:leg prefix="FR" x_reflect="1" y_reflect="-1" hip_x="0.18" hip_y="-0.14"/>
<xacro:leg prefix="RL" x_reflect="-1" y_reflect="1" hip_x="-0.18" hip_y="0.14"/>
<xacro:leg prefix="RR" x_reflect="-1" y_reflect="-1" hip_x="-0.18" hip_y="-0.14"/>
</robot>
